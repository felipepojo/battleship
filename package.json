{
  "name": "battleship",
  "private": true,
  "version": "1.0.0",
  "description": "Single-player Battleship in the browser against an AI opponent with easy, medium and hard difficulty levels. Static React + TypeScript app.",
  "keywords": [
    "battleship",
    "game",
    "ai",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://felipepojo.github.io/battleship/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipepojo/battleship.git"
  },
  "bugs": {
    "url": "https://github.com/felipepojo/battleship/issues"
  },
  "author": "Felipe Pojo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
